{
  "schemaVersion": 1,
  "build": {
    "taskfile": "Taskfile.yml",
    "task": "release",
    "command": null,
    "production": true,
    "cgoEnabled": true,
    "appName": "pp_keyboard"
  },
  "entry": {
    "executablePath": ""
  },
  "assets": [
    {
      "src": "/Users/mac/Documents/GitHub/Peirato-s-Piano-Keyboard/bin/updater",
      "type": "file",
      "required": true,
      "target": "MacOS"
    }
  ],
  "windows": {
    "enabled": true,
    "innoScript": "builder/windows/inno.iss",
    "isccPath": "",
    "defaultDirName": "{autopf}\\${project.name}",
    "privilegesRequired": "lowest",
    "setupIcon": "assets/installer.ico",
    "outputBaseName": "${project.name}-${project.version}-${package.platform}-setup",
    "appURL": "https://piano.peirato.com/",
    "createDesktopShortcut": true
  },
  "macos": {
    "dmgMode": "official",
    "enabled": true,
    "appBundle": "bin/${project.name}.app",
    "background": "/Users/mac/Documents/GitHub/Peirato-s-Piano-Keyboard/dmg-background.png",
    "windowWidth": 640,
    "windowHeight": 420,
    "iconSize": 108,
    "appX": 180,
    "appY": 210,
    "applicationsX": 460,
    "applicationsY": 210
  },
  "artifacts": {
    "outputRoot": "builder/release"
  }
}
